{
  "name": "ticketasy-print-relay",
  "version": "1.0.0",
  "description": "Print Relay Agent - Connects to Ticketasy backend and prints receipts silently",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "package:win": "pkg dist/index.js --targets node20-win-x64 --output release/TicketasyPrint.exe",
    "package:mac": "pkg dist/index.js --targets node20-macos-x64 --output release/TicketasyPrint",
    "package:linux": "pkg dist/index.js --targets node20-linux-x64 --output release/ticketasy-print-relay"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "escpos-network": "^3.0.0-alpha.4",
    "conf": "^12.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "pkg": "^5.8.1"
  }
}
